---
import "../styles/global.css";
import Loader from "../components/Loader.astro";
import Header from "../components/Header.astro";

const SITE = "https://belfastcm.com";

const {
  title,
  description,
  path = "/",
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE).href;
const ogImage = `${SITE}/logo-og.png`;
---

<!doctype html>
<html lang="es" class="is-loading">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Belfast Construction Management" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" href="/fonts/SF-Pro-Display-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Cormorant-Garamond-400.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <Loader />
    <Header />
    <slot />
    <footer class="site-footer">
      <p>Copyright © 2026 Belfast Construction Management - All Rights Reserved</p>
      <p>Sitio realizado por <a href="https://deploystudio.com.ar/" target="_blank" rel="noopener noreferrer">/deploy_</a></p>
    </footer>
  </body>
</html>

<style is:global>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 1.25rem var(--gutter);
    font-size: 0.75rem;
    color: var(--grey-mid);
  }
  .site-footer p { margin: 0; }
  .site-footer a { color: inherit; font-weight: 600; }
  .site-footer a:hover,
  .site-footer a:focus-visible { color: var(--ink); }
</style>
