---
import { Image } from "astro:assets";
import { obras } from "../data/obras.js";
---

<section class="obras" aria-labelledby="obras-title">
  <div class="obras__stage">
  <h2 class="obras__heading" id="obras-title">Nuestras obras</h2>

  <div class="obras__list" data-obras>
    <ul class="obras__items">
      {
        obras.map((o) => (
          <li>
            <a class="obras__item" href={`/obras/${o.slug}`}>
              {o.nombre}
            </a>
          </li>
        ))
      }
    </ul>

    <figure class="obras__preview" aria-hidden="true">
      {
        obras.map((o) => (
          <Image
            class="obras__img"
            src={o.src}
            alt=""
            widths={[320, 506]}
            sizes="(max-width: 700px) 40vw, 16vw"
            format="webp"
            quality={78}
            loading="lazy"
            decoding="async"
          />
        ))
      }
    </figure>
  </div>
  </div>
</section>

<style is:global>
  /* La sección ocupa una pantalla: el título sobre el margen izquierdo (como
     el resto del inicio) y las 6 obras centradas, con el tamaño de los
     nombres atado también al alto para que siempre entren. */
  .obras__stage {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(5.5rem, 12svh, 8rem) var(--gutter) clamp(2rem, 6svh, 4rem);
    text-align: center;
  }
  .obras__heading {
    align-self: flex-start;
    text-align: left;
    margin: 0 0 clamp(1rem, 3svh, 2.5rem);
    font-family: var(--font-detail);
    font-weight: 400;
    font-size: clamp(1.25rem, 2.2vw, 2rem);
    line-height: 1.1;
  }

  .obras__list {
    position: relative;
    width: 100%;
  }
  .obras__items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Degular (demo: solo a-z, A-Z y números). El gris apagado sigue por encima
     de 3:1 sobre blanco, el mínimo para texto grande. */
  .obras__item {
    display: block;
    width: fit-content;
    margin-inline: auto;
    padding-block: 0.04em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, min(10vw, 11svh), 8rem);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #929292;
    border-bottom: 0;
    transition: color 0.25s ease;
  }
  .obras__item.is-active,
  .obras__item:focus-visible { color: var(--ink); }

  /* Una sola foto que se desliza hasta la fila activa y sigue al mouse en
     horizontal. Las posiciones --x / --y las calcula el script. */
  .obras__preview {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: clamp(150px, 15vw, 240px);
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
    border-radius: 2px;
    background: var(--ink);
    opacity: 0;
    pointer-events: none;
    transform: translate(var(--x, 0px), var(--y, 0px)) translate(-50%, -50%);
    transition: opacity 0.3s ease;
    will-change: transform;
  }
  .obras__preview.is-on { opacity: 1; }
  .obras__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    /* las fotos forman una tira vertical dentro de la ventana: la activa en
       0, las de obras anteriores arriba y las siguientes abajo. Al pasar de
       una obra a otra la tira corre y la foto nueva entra desde el lado por
       donde vas (si bajás, desde abajo; si subís, desde arriba). */
    transform: translateY(100%);
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .obras__img.is-above { transform: translateY(-100%); }
  .obras__img.is-active { transform: none; }
  /* las fotos que no participan del cambio se reubican sin animar */
  .obras__img.jump { transition: none; }

  /* ---------- Sección fija con entrada atada al scroll (JS) ----------
     Misma mecánica que el slogan y el bloque de presentación, pero más
     tranquila: poco recorrido y desplazamientos chicos. Primero el título y
     después cada obra, una tras otra. */
  .obras--anim {
    height: calc(100svh + 110svh);
  }
  .obras--anim .obras__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
  }
  .obras--anim .obras__heading {
    opacity: var(--h, 0);
    transform: translateY(calc((1 - var(--h, 0)) * 16px));
  }
  .obras--anim .obras__item {
    opacity: var(--o, 0);
    transform: translateY(calc((1 - var(--o, 0)) * 36px));
  }
  /* una fila todavía invisible no reacciona al mouse ni al toque */
  .obras--anim .obras__item:not(.is-visible) { pointer-events: none; }

  @media (prefers-reduced-motion: reduce) {
    .obras__img { transition: none; }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>("[data-obras]");

  if (list) {
    const items = Array.from(list.querySelectorAll<HTMLElement>(".obras__item"));
    const imgs = Array.from(list.querySelectorAll<HTMLElement>(".obras__img"));
    const preview = list.querySelector<HTMLElement>(".obras__preview")!;
    const hover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
    const target = { x: 0, y: 0 };
    const cur = { x: 0, y: 0 };
    let active = -1;
    let frame = 0;

    function rowY(i: number) {
      // se mide el <li> (que no se mueve) y no el link, que sube durante la
      // entrada animada
      const l = list!.getBoundingClientRect();
      const r = items[i].parentElement!.getBoundingClientRect();
      return r.top - l.top + r.height / 2;
    }

    function restX() {
      // sin mouse la foto queda a la derecha; con mouse arranca en el 62%
      const w = list!.getBoundingClientRect().width;
      const half = preview.offsetWidth / 2;
      return hover ? clamp(w * 0.62, half, w - half) : w - half;
    }

    function step() {
      frame = 0;
      const k = reduced ? 1 : 0.16;
      cur.x += (target.x - cur.x) * k;
      cur.y += (target.y - cur.y) * k;
      preview.style.setProperty("--x", `${cur.x}px`);
      preview.style.setProperty("--y", `${cur.y}px`);
      if (Math.abs(target.x - cur.x) > 0.4 || Math.abs(target.y - cur.y) > 0.4) {
        frame = requestAnimationFrame(step);
      }
    }
    const kick = () => { if (!frame) frame = requestAnimationFrame(step); };

    // la foto aparece al pasar sobre un título y se esconde al salir; entre
    // un título y otro la pausa es mínima para que se deslice sin cortarse
    let hideTimer = 0;

    // acomoda la tira de fotos: solo la anterior y la nueva se animan; el resto
    // se reubica al instante para no cruzar la ventana. Con prev = -1 (primera
    // vez) no se anima ninguna.
    function placeImages(i: number, prev: number) {
      imgs.forEach((el, j) => {
        const instant = prev === -1 || (j !== i && j !== prev);
        if (instant) el.classList.add("jump");
        el.classList.toggle("is-above", j < i);
        el.classList.toggle("is-active", j === i);
        if (instant) {
          void el.offsetWidth;
          el.classList.remove("jump");
        }
      });
    }

    function setActive(i: number, pointerX?: number) {
      window.clearTimeout(hideTimer);
      if (i === active) return;
      const first = active === -1;
      const prev = active;
      active = i;
      items.forEach((el, j) => el.classList.toggle("is-active", j === i));
      placeImages(i, prev);
      target.y = rowY(i);
      if (first) {
        const l = list!.getBoundingClientRect();
        const half = preview.offsetWidth / 2;
        target.x = pointerX === undefined ? restX() : clamp(pointerX - l.left, half, l.width - half);
        cur.x = target.x;
        cur.y = target.y;
      }
      preview.classList.add("is-on");
      kick();
    }

    function clearActive() {
      active = -1;
      items.forEach((el) => el.classList.remove("is-active"));
      preview.classList.remove("is-on");
    }
    const scheduleClear = () => {
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(clearActive, 120);
    };

    items.forEach((el, i) => {
      el.addEventListener("focus", () => setActive(i));
      el.addEventListener("blur", scheduleClear);
      el.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") setActive(i, e.clientX);
      });
      el.addEventListener("pointerleave", (e) => {
        if (e.pointerType === "mouse") scheduleClear();
      });
    });

    list.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse" || active === -1) return;
      const l = list.getBoundingClientRect();
      const half = preview.offsetWidth / 2;
      target.x = clamp(e.clientX - l.left, half, l.width - half);
      kick();
    });

    // en pantallas táctiles no hay "pasar por encima": mientras se scrollea
    // queda activa la fila que cruza el centro de la pantalla
    if (!hover) {
      const center = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const el = e.target as HTMLElement;
            if (e.isIntersecting && el.classList.contains("is-visible")) setActive(items.indexOf(el));
          });
        },
        { rootMargin: "-45% 0px -45% 0px" },
      );
      items.forEach((el) => center.observe(el));
    }

    window.addEventListener("resize", () => {
      if (active === -1) return;
      target.y = rowY(active);
      if (!hover) target.x = restX();
      kick();
    });

    // ---- sección fija: título y obras entran con el scroll ----
    const section = list.closest<HTMLElement>(".obras")!;
    const stage = section.querySelector<HTMLElement>(".obras__stage")!;
    const heading = section.querySelector<HTMLElement>(".obras__heading")!;

    if (reduced) {
      items.forEach((el) => el.classList.add("is-visible"));
    } else {
      const range = (p: number, from: number, to: number) => clamp((p - from) / (to - from), 0, 1);
      const ease = (t: number) => t * t * (3 - 2 * t);
      let forced = false;
      let ticking = false;

      function update() {
        ticking = false;
        const total = section.offsetHeight - stage.offsetHeight;
        const p = forced ? 1 : clamp(-section.getBoundingClientRect().top / total, 0, 1);
        heading.style.setProperty("--h", ease(range(p, 0, 0.18)).toFixed(3));
        items.forEach((el, i) => {
          const start = 0.12 + i * 0.09;
          const o = ease(range(p, start, start + 0.22));
          el.style.setProperty("--o", o.toFixed(3));
          el.classList.toggle("is-visible", o > 0.6);
        });
      }

      // con teclado se puede llegar a una obra que todavía no apareció: al
      // enfocar cualquiera, la lista se muestra completa
      list.addEventListener("focusin", () => {
        forced = true;
        update();
      });

      section.classList.add("obras--anim");
      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
      window.addEventListener("resize", update);
      update();
    }
  }
</script>
