---
import { Image } from "astro:assets";
import { fotos as photos } from "../data/obras.js";

const slogan = "We portray what we aspire to see.";
// siempre en dos renglones: "We portray what" / "we aspire to see."
const sloganLines = ["We portray what", "we aspire to see."];

// cada letra es un span numerado (los espacios no cuentan): al llegar al bloque
// se van pintando de negro solas, una tras otra (CSS, con retardo por letra)
let letterIndex = 0;
const lines = sloganLines.map((line) =>
  [...line].map((ch) => (ch === " " ? { ch, i: null } : { ch, i: letterIndex++ })),
);
---

<section class="seq" id="slogan" style={`--n:${photos.length}`} aria-label="Slogan y obras">
  <div class="seq__stage">
    <p class="seq__slogan" lang="en">
      <span class="sr-only">{slogan}</span>
      {
        lines.map((tokens, i) => (
          <span class="slogan__line" style={`--i:${i}`} aria-hidden="true">
            <span>{tokens.map((t) => (t.i === null ? " " : <span class="ch" style={`--k:${t.i}`}>{t.ch}</span>))}</span>
          </span>
        ))
      }
    </p>

    <ul class="seq__cards">
      {
        photos.map((p) => (
          <li class="seq__card">
            <Image
              src={p.src}
              alt={p.alt}
              widths={[360, 506]}
              sizes="(max-width: 700px) 45vw, 22vw"
              format="webp"
              quality={78}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ul>

    <a class="link-arrow seq__link" href="/obras">
      <span>Explorá nuestras obras</span>
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
        <path d="M3 11 11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.3" />
      </svg>
    </a>
  </div>
</section>

<style is:global>
  /* Base (sin JS o con reduced-motion): slogan, una sola foto y el acceso,
     en flujo normal. La secuencia pegajosa la activa .seq--on desde JS. */
  .seq__stage {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 4svh, 3rem);
    padding: 14svh var(--gutter) 12svh;
  }

  .seq__slogan {
    margin: 0;
    font-family: var(--font-detail);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(3.25rem, 12.5vw, 12rem);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .slogan__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    margin-left: calc(var(--i) * clamp(0.75rem, 4.5vw, 4.5rem));
  }
  .slogan__line > span {
    display: inline-block;
    transform: translateY(112%);
    transition: transform 1.1s cubic-bezier(0.65, 0, 0.35, 1) calc(var(--i) * 0.14s);
  }
  .seq.is-in .slogan__line > span { transform: translateY(0); }

  /* Pintado automático: con JS las letras arrancan en gris apagado y, al llegar
     al bloque (un instante después de que el slogan sube), se pintan de negro
     solas, una tras otra. No depende del scroll y se repite cada vez que se
     vuelve a entrar al bloque, desde arriba o desde abajo. Sin JS o con
     reduced-motion el slogan queda negro de entrada (.seq--on no se agrega). */
  .seq--on .ch {
    color: #adadad;
    transition: color 0.55s ease calc(var(--k) * 55ms);
  }
  .seq--on.is-painted .ch { color: var(--ink); }
  /* al salir del bloque vuelven a gris de golpe (ya no se ve) para poder
     pintarse otra vez al volver */
  .seq--on.is-reset .ch { transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .slogan__line > span { transform: none; }
  }

  .seq__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    align-self: flex-end;
    height: min(52svh, 480px);
    aspect-ratio: 9 / 16;
  }
  .seq__card {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 2px;
    background: var(--ink);
  }
  .seq__card:not(:first-child) { display: none; }
  .seq__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.35s ease, transform 0.35s ease;
  }
  /* solo con mouse real: en touch el :hover queda "pegado" en la última
     foto tocada */
  @media (hover: hover) and (pointer: fine) {
    .seq__card img:hover {
      filter: grayscale(0) contrast(1.05);
      transform: scale(1.04);
    }
  }

  .seq__link { align-self: flex-start; }

  /* ---------- Secuencia pegajosa (JS) ---------- */

  .seq--on {
    --unit: 62svh;
    position: relative;
    height: calc(100svh + (var(--n) + 0.5) * var(--unit));
  }
  .seq--on .seq__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    display: block;
    padding: 0;
    overflow: hidden;
  }
  .seq--on .seq__slogan {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    font-size: clamp(3rem, min(9vw, 16svh), 11rem);
  }
  .seq--on .seq__cards {
    position: absolute;
    right: clamp(1.25rem, 7vw, 8rem);
    top: 50%;
    transform: translateY(-50%);
    height: min(64svh, 600px);
    overflow: hidden;
    border-radius: 2px;
  }
  .seq--on .seq__card:not(:first-child) { display: block; }
  .seq--on .seq__card {
    transform: translateY(var(--y, 100%)) scale(calc(1 - 0.045 * var(--cover, 0)));
    will-change: transform;
  }
  .seq--on .seq__card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #000;
    opacity: calc(var(--cover, 0) * 0.45);
    pointer-events: none;
  }
  .seq--on .seq__link {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(1.5rem, 5svh, 3rem);
  }

  /* tablet: la foto queda a la derecha, junto al slogan; con dos renglones
     largos hay que achicarlo un poco para que no la toque */
  @media (min-width: 701px) and (max-width: 899.98px) {
    .seq--on .seq__slogan { font-size: min(6.3vw, 16svh); }
  }

  @media (max-width: 700px) {
    .seq--on .seq__slogan { top: 19svh; transform: none; font-size: clamp(2.75rem, 12.5vw, 4.5rem); }
    .seq--on .seq__cards {
      top: auto;
      bottom: clamp(4.5rem, 12svh, 7rem);
      right: var(--gutter);
      transform: none;
      height: min(36svh, 300px);
    }
  }
</style>

<script>
  const seq = document.querySelector<HTMLElement>(".seq");
  const sloganText = document.querySelector(".seq__slogan");

  if (seq && sloganText) {
    // el slogan sube línea por línea cuando entra a la pantalla (retardo por
    // --i en el CSS); se observa el texto y no la sección, que es muy alta
    // "dentro" = se ve al menos el 35 % del slogan (el bloque es alto y el slogan
    // queda fijo mientras se recorre: se entra por arriba o por abajo). Al entrar
    // se pintan las letras; al salir vuelven a gris para repetirlo la próxima vez.
    let dentro = false;
    let pintura = 0;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const ahora = e.intersectionRatio >= 0.35;
          if (ahora === dentro) return;
          dentro = ahora;
          window.clearTimeout(pintura);
          if (ahora) {
            seq.classList.add("is-in");
            seq.classList.remove("is-reset");
            // el slogan sube primero (solo la primera vez); las letras se
            // pintan un momento después
            pintura = window.setTimeout(() => seq.classList.add("is-painted"), 700);
          } else {
            seq.classList.add("is-reset");
            seq.classList.remove("is-painted");
          }
        });
      },
      { threshold: [0, 0.35] },
    );
    io.observe(sloganText);

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      initSequence(seq);
    }
  }

  function initSequence(section: HTMLElement) {
    const stage = section.querySelector<HTMLElement>(".seq__stage")!;
    const cards = Array.from(section.querySelectorAll<HTMLElement>(".seq__card"));
    const units = cards.length + 0.5;
    const last: string[] = [];
    let ticking = false;

    const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
    const ease = (u: number) => (u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2);

    section.classList.add("seq--on");

    // cada foto entra desde el borde inferior del marco y tapa a la anterior;
    // la anterior se achica y se oscurece un poco mientras la nueva la cubre
    function update() {
      ticking = false;
      const total = section.offsetHeight - stage.offsetHeight;
      const progress = clamp(-section.getBoundingClientRect().top / total, 0, 1);
      const t = progress * units;

      cards.forEach((card, i) => {
        const y = (1 - ease(clamp(t - i, 0, 1))) * 100;
        const cover = i < cards.length - 1 ? clamp(t - (i + 1), 0, 1) : 0;
        const key = `${y.toFixed(2)}|${cover.toFixed(3)}`;
        if (last[i] === key) return;
        last[i] = key;
        card.style.setProperty("--y", `${y}%`);
        card.style.setProperty("--cover", String(cover));
        card.style.zIndex = String(i);
      });
    }

    function request() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", request);
    update();

    // las fotos arrancan en lazy; una vez cargada la página se piden todas
    // para que ninguna aparezca vacía a mitad de la secuencia
    window.addEventListener("load", () => {
      cards.forEach((card) => {
        card.querySelector("img")?.setAttribute("loading", "eager");
      });
    });
  }
</script>
