---
// Destello amarillo de fondo (Cómo trabajamos, Qué hacemos y Contacto): una capa
// fija detrás del contenido, con dos manchas de los amarillos de la paleta.
//  - Con mouse: siguen al cursor con distinto retraso (la principal rápida, la
//    otra lenta) y se apagan al salir de la ventana.
//  - Sin mouse (celular, tablet): se ven siempre; arrancan bien arriba, a la
//    derecha, y van bajando con el scroll.
//  - Con prefers-reduced-motion: sin deslizamiento (con mouse aparece sin
//    retraso; sin mouse queda quieto arriba).
// Se usa como <Destello /> adentro del <main>.
---

<div class="destello" aria-hidden="true" data-destello>
  <span class="destello__mancha destello__mancha--lenta"></span>
  <span class="destello__mancha"></span>
</div>

<style is:global>
  .destello {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  /* más transparente: acompaña, no compite con el texto */
  .destello.is-on { opacity: 0.55; }
  .destello__mancha {
    --s: clamp(26rem, 34vw, 40rem);
    position: absolute;
    left: 0;
    top: 0;
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    background: radial-gradient(
      closest-side,
      rgba(232, 211, 0, 0.5),
      rgba(232, 211, 0, 0.26) 42%,
      rgba(213, 185, 0, 0.08) 72%,
      transparent
    );
    transform: translate3d(var(--gx, 50vw), var(--gy, 50vh), 0);
    will-change: transform;
  }
  .destello__mancha--lenta {
    --s: clamp(40rem, 58vw, 70rem);
    background: radial-gradient(
      closest-side,
      rgba(232, 211, 0, 0.22),
      rgba(213, 185, 0, 0.09) 55%,
      transparent
    );
    transform: translate3d(var(--sx, 50vw), var(--sy, 50vh), 0);
  }
  /* sin mouse: se ve siempre; arranca arriba a la derecha y el script lo baja
     con el scroll (valores iniciales para cuando no hay JS o con
     reduced-motion: quieto arriba) */
  @media (hover: none), (pointer: coarse) {
    .destello {
      opacity: 0.55;
      --gx: 76vw;
      --gy: 14vh;
      --sx: 24vw;
      --sy: 22vh;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .destello { transition: none; }
  }
</style>

<script>
  const glow = document.querySelector<HTMLElement>("[data-destello]");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

  // ----- con mouse: dos manchas siguen al cursor, una más lenta que la otra -----
  if (glow && fine.matches) {
    const fast = calm.matches ? 1 : 0.16;
    const slow = calm.matches ? 1 : 0.06;
    let tx = 0;
    let ty = 0;
    let ax = 0;
    let ay = 0;
    let bx = 0;
    let by = 0;
    let raf = 0;

    function frame() {
      ax += (tx - ax) * fast;
      ay += (ty - ay) * fast;
      bx += (tx - bx) * slow;
      by += (ty - by) * slow;
      glow!.style.setProperty("--gx", `${ax.toFixed(1)}px`);
      glow!.style.setProperty("--gy", `${ay.toFixed(1)}px`);
      glow!.style.setProperty("--sx", `${bx.toFixed(1)}px`);
      glow!.style.setProperty("--sy", `${by.toFixed(1)}px`);
      const resto = Math.abs(tx - ax) + Math.abs(ty - ay) + Math.abs(tx - bx) + Math.abs(ty - by);
      raf = resto > 1 ? requestAnimationFrame(frame) : 0;
    }

    // la capa es fija: las coordenadas son las de la ventana, en cualquier punto
    // del scroll
    window.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      tx = e.clientX;
      ty = e.clientY;
      // al entrar, las manchas nacen bajo el cursor (no vienen desde la esquina)
      if (!glow.classList.contains("is-on")) {
        ax = bx = tx;
        ay = by = ty;
        glow.classList.add("is-on");
      }
      if (!raf) raf = requestAnimationFrame(frame);
    });
    document.documentElement.addEventListener("pointerleave", () => glow.classList.remove("is-on"));
  }

  // ----- sin mouse (celular, tablet): arranca bien arriba y baja con el scroll;
  // la mancha lenta va un poco más arriba, con otro ritmo -----
  if (glow && !fine.matches && !calm.matches) {
    let esperando = false;
    function bajar() {
      esperando = false;
      const w = window.innerWidth;
      const h = window.innerHeight;
      const max = document.documentElement.scrollHeight - h;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      glow!.style.setProperty("--gx", `${(w * 0.76).toFixed(0)}px`);
      glow!.style.setProperty("--gy", `${(h * (0.14 + p * 0.74)).toFixed(0)}px`);
      glow!.style.setProperty("--sx", `${(w * (0.24 + p * 0.1)).toFixed(0)}px`);
      glow!.style.setProperty("--sy", `${(h * (0.2 + p * 0.55)).toFixed(0)}px`);
    }
    window.addEventListener(
      "scroll",
      () => {
        if (!esperando) {
          esperando = true;
          requestAnimationFrame(bajar);
        }
      },
      { passive: true },
    );
    window.addEventListener("resize", bajar);
    bajar();
  }
</script>
