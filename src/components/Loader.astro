---
---

<div class="loader" id="loader" aria-hidden="true">
  <svg class="blueprint-lines" id="blueprintLines"></svg>
  <div class="logo-wrap" id="logoWrap">
    <img
      class="logo-wordmark"
      id="logoWordmark"
      src="/recursos-marca/wordmark-belfast-cm-black.png"
      alt=""
      width="1044"
      height="127"
    />
  </div>
</div>

<noscript>
  <style>
    .loader { display: none; }
    html.is-loading { overflow: auto; }
    .site-logo { opacity: 1 !important; }
    .slogan__line > span { transform: none !important; }
  </style>
</noscript>

<style is:global>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    transition: background-color 0.6s ease;
  }

  .blueprint-lines {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  .blueprint-lines line {
    stroke: #d6d6d6;
    stroke-width: 0.75px;
    vector-effect: non-scaling-stroke;
    fill: none;
    transition: stroke-dashoffset 0.75s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .blueprint-lines.is-faded { opacity: 0; }

  .logo-wrap {
    position: relative;
    width: min(62vw, 420px, 46svh);
    aspect-ratio: 1674 / 1647;
    transition: transform 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* Posiciones en % relativas al mismo .logo-wrap que escala en todos los
     breakpoints, medidas sobre el archivo original de la clienta (canvas
     1674x1647): el wordmark queda proporcional al isotipo siempre. */
  .logo-wordmark {
    position: absolute;
    top: 69.62%;
    left: 50%;
    width: 62.37%;
    height: auto;
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 0.5s ease 0.7s;
  }
  .logo-wordmark.revealed { opacity: 1; }
  .logo-wrap.is-wordmark-only .logo-wordmark { top: 0; width: 160%; }

  .isotipo-piezas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transition: opacity 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .isotipo-piezas path {
    fill: transparent;
    stroke: #111;
    stroke-width: 4;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.7s cubic-bezier(0.65, 0, 0.35, 1), fill 0.4s ease;
  }
  .isotipo-piezas path.drawn { stroke-dashoffset: 0; }
  .isotipo-piezas path.filled { fill: #e8d300; stroke: #e8d300; }

  .loader.is-transparent {
    background: transparent;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .logo-wrap { width: 58vw; }
    .logo-wrap.is-wordmark-only .logo-wordmark { width: 100%; }
    .blueprint-lines line { stroke-width: 0.4px; }
  }
</style>

<script>
  import "../scripts/loader.js";
</script>
