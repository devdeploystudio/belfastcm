---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ProyectoCta from "../../components/ProyectoCta.astro";
import { obras, ESTADOS } from "../../data/obras.js";

export function getStaticPaths() {
  return obras.map((obra, i) => ({
    params: { slug: obra.slug },
    props: {
      obra,
      index: i,
      anterior: obras[(i - 1 + obras.length) % obras.length],
      siguiente: obras[(i + 1) % obras.length],
    },
  }));
}

const { obra, index, anterior, siguiente } = Astro.props;

const datos = [
  { label: "Ubicación", value: obra.ubicacion },
  { label: "Año", value: obra.anio },
  { label: "Estado", value: ESTADOS[obra.estado] },
  { label: "Estudio de arquitectura", value: obra.estudio },
  { label: "Trabajo realizado por Belfast", value: obra.trabajo },
];
// `noindex` en <Base>: los datos de las obras son provisorios; sacarlo cuando
// estén los reales.
---

<Base
  title={`${obra.nombre} - Belfast CM`}
  description={`${obra.nombre}: ${obra.ubicacion}. Una obra de Belfast Construction Management.`}
  path={`/obras/${obra.slug}`}
  noindex
>
  <main class="obra-page">
    <nav class="obra-page__back" aria-label="Volver">
      <a class="link-arrow link-arrow--back" href="/obras">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M11 11 3 3M9 3H3v6" fill="none" stroke="currentColor" stroke-width="1.3" />
        </svg>
        <span>Todas las obras</span>
      </a>
    </nav>

    <header class="obra-page__head">
      <span class="obra-page__index" data-reveal>{`/0${index + 1}`}</span>
      <h1 class="obra-page__title page-title" data-reveal>{obra.nombre}</h1>
    </header>

    <div class="obra-page__main">
      <div class="obra-page__info">
        <p class="obra-page__desc" data-reveal>{obra.descripcion}</p>
        <dl class="obra-datos" data-reveal>
          {
            datos.map((d) => (
              <div class="obra-datos__row">
                <dt>{d.label}</dt>
                <dd>{d.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <figure class="obra-page__hero" data-reveal>
        <Image
          src={obra.src}
          alt={obra.alt}
          widths={[640, 506]}
          sizes="(max-width: 899px) 90vw, 46vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>

    <ul class="obra-galeria">
      {
        obra.galeria.map((f: { src: ImageMetadata; alt: string }) => (
          <li data-reveal>
            <Image
              src={f.src}
              alt={f.alt}
              widths={[480, 506]}
              sizes="(max-width: 899px) 90vw, 44vw"
              format="webp"
              quality={78}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ul>

    <nav class="obra-nav" aria-label="Otras obras">
      <a class="obra-nav__link" href={`/obras/${anterior.slug}`} rel="prev">
        <span class="obra-nav__label">Obra anterior</span>
        <span class="obra-nav__name">{anterior.nombre}</span>
      </a>
      <a class="obra-nav__link obra-nav__link--next" href={`/obras/${siguiente.slug}`} rel="next">
        <span class="obra-nav__label">Siguiente obra</span>
        <span class="obra-nav__name">{siguiente.nombre}</span>
      </a>
    </nav>
  </main>

  <ProyectoCta />
</Base>

<style is:global>
  .obra-page {
    padding: clamp(7rem, 14vw, 10rem) var(--gutter) clamp(4rem, 8vw, 7rem);
  }

  .link-arrow--back svg { order: -1; }
  .link-arrow--back:hover svg,
  .link-arrow--back:focus-visible svg { transform: translate(-2px, -2px); }
  .obra-page__back { margin-bottom: clamp(2rem, 5vw, 4rem); }

  .obra-page__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .obra-page__index {
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    color: var(--grey-mid);
  }

  /* datos + foto principal */
  .obra-page__main {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .obra-page__info {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .obra-page__desc {
    margin: 0;
    max-width: 46ch;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--grey-dark);
  }
  .obra-datos {
    margin: 0;
    border-top: 1px solid var(--grey-line);
  }
  .obra-datos__row {
    display: grid;
    grid-template-columns: minmax(8rem, 12rem) 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--grey-line);
  }
  .obra-datos dt {
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--grey-mid);
  }
  .obra-datos dd {
    margin: 0;
    font-size: 1rem;
    color: var(--ink);
  }

  .obra-page__hero {
    margin: 0;
    overflow: hidden;
    background: var(--ink);
  }
  .obra-page__hero img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  /* fotos de la obra */
  .obra-galeria {
    display: grid;
    gap: clamp(1rem, 2vw, 2rem);
    list-style: none;
    margin: 0 0 clamp(4rem, 9vw, 8rem);
    padding: 0;
  }
  .obra-galeria li { overflow: hidden; background: var(--ink); }
  .obra-galeria img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  /* obra anterior / siguiente */
  .obra-nav {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--grey-line);
  }
  .obra-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border-bottom: 0;
  }
  .obra-nav__link--next { text-align: right; }
  .obra-nav__label {
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--grey-mid);
  }
  .obra-nav__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-card);
    line-height: 1.05;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .obra-nav__link:hover .obra-nav__name,
  .obra-nav__link:focus-visible .obra-nav__name { border-color: var(--ink); }

  @media (min-width: 900px) {
    .obra-page__main {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 2vw, 2rem);
      align-items: start;
    }
    .obra-page__info { grid-column: 1 / span 5; position: sticky; top: 6rem; }
    .obra-page__hero { grid-column: 7 / span 6; }
    .obra-galeria { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .obra-galeria li:nth-child(2) { margin-top: clamp(3rem, 8vw, 8rem); }
  }
</style>
