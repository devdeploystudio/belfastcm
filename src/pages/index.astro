---
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import SloganSequence from "../components/SloganSequence.astro";
import Intro from "../components/Intro.astro";
import ObrasLista from "../components/ObrasLista.astro";
import ProyectoCta from "../components/ProyectoCta.astro";
// Cuadro del video de obra (en blanco y negro): se ve de inmediato y de
// respaldo cuando el video no se reproduce (reduced-motion, ahorro de datos).
// Hay dos, igual que los videos: horizontal (desktop) y vertical (celular).
import heroPoster from "../assets/hero/hero-poster.jpg";
import heroPosterV from "../assets/hero/hero-poster-v.jpg";

const posterH = await getImage({ src: heroPoster, width: 1280, format: "webp", quality: 82 });
const posterV = await getImage({ src: heroPosterV, width: 720, format: "webp", quality: 82 });

const title = "Belfast Construction Management";
const description =
  "Belfast Construction Management: construcción de casas en countries y obras para estudios de arquitectura.";

const organization = {
  "@context": "https://schema.org",
  // constructora con local: incluye la direccion de la oficina
  "@type": "GeneralContractor",
  image: "https://belfastcm.com/logo-og.png",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Del Portal, Local 10",
    addressLocality: "Rincón de Milberg",
    addressRegion: "Buenos Aires",
    addressCountry: "AR",
  },
  name: "Belfast Construction Management",
  url: "https://belfastcm.com/",
  logo: "https://belfastcm.com/logo-og.png",
  telephone: "+5491130498308",
  email: "info@belfastcm.com",
  sameAs: [
    "https://www.instagram.com/belfast_cm",
    "https://www.facebook.com/BelfastCM/",
    "https://www.linkedin.com/company/belfast-cm/",
  ],
};
---

<Base title={title} description={description} path="/">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(organization)} />

  <main>
    <h1 class="sr-only">Belfast Construction Management</h1>

    <section class="hero" data-hero aria-label="Inicio">
      <!-- en pantallas más altas que anchas (celular) va la portada vertical -->
      <picture>
        <source media="(max-aspect-ratio: 1/1)" srcset={posterV.src} />
        <img
          class="hero__img"
          src={posterH.src}
          alt=""
          width={posterH.attributes.width}
          height={posterH.attributes.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <video
        class="hero__video"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
        data-src-h="/video/hero-h.mp4"
        data-src-v="/video/hero-v.mp4"
      ></video>
      <div class="hero__shade" aria-hidden="true"></div>
      <!-- grano de película sobre el video: disimula la baja resolución del
           original y le da textura -->
      <div class="hero__grain" aria-hidden="true"></div>
      <a class="scroll-cue" href="#slogan">
        <span class="scroll-cue__label">Scroll</span>
        <span class="scroll-cue__line" aria-hidden="true"></span>
      </a>
    </section>

    <div class="page-body">
      <SloganSequence />
      <Intro />
      <ObrasLista />
      <ProyectoCta />
    </div>
  </main>
</Base>

<style is:global>
  /* La foto queda fija y el contenido blanco sube y la va tapando. */
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--ink);
  }
  .hero__img,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__video {
    opacity: 0;
    transition: opacity 1s ease;
  }
  .hero__video.is-playing { opacity: 1; }
  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.5));
  }
  /* Grano: una textura de ruido (public/grano.png) que se repite y salta de lugar
     ocho veces por segundo, como el grano de una película. La intensidad es el
     opacity; el tamaño del grano, el background-size. */
  .hero__grain {
    position: absolute;
    inset: 0;
    background: url("/grano.png") 0 0 / 220px 220px;
    opacity: 0.2;
    pointer-events: none;
    animation: hero-grano 1s steps(1) infinite;
  }
  /* en el celular el video se ve más grande y de más cerca: grano más suave */
  @media (max-width: 699px) {
    .hero__grain { opacity: 0.15; }
  }
  @keyframes hero-grano {
    0% { background-position: 0 0; }
    12.5% { background-position: -47px 31px; }
    25% { background-position: 83px -62px; }
    37.5% { background-position: -29px -95px; }
    50% { background-position: 112px 40px; }
    62.5% { background-position: -78px 71px; }
    75% { background-position: 24px -33px; }
    87.5% { background-position: -102px -14px; }
  }
  .page-body {
    position: relative;
    z-index: 1;
    background: var(--bg);
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4svh, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    transform: translateX(-50%);
    border-bottom: 0;
    color: #fff;
    opacity: 0;
    transition: opacity 0.8s ease 0.2s;
  }
  .scroll-cue:focus-visible { outline-color: #fff; }
  html.is-loaded .scroll-cue { opacity: 1; }
  .scroll-cue__label {
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .scroll-cue__line {
    width: 1px;
    height: 3rem;
    background: #fff;
    transform-origin: top;
    animation: cue-line 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes cue-line {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue__line { animation: none; }
    .hero__grain { animation: none; }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>(".hero__video");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  // Con reduced-motion o ahorro de datos no se descarga ni se reproduce: queda
  // el cuadro fijo. Si no, se elige la versión según la forma de la pantalla:
  // vertical si es más alta que ancha (celular), horizontal si no. Si cambia (se
  // gira el celular), se cambia de video.
  if (video && !reduced && !saveData) {
    const vertical = window.matchMedia("(max-aspect-ratio: 1/1)");
    const cargar = () => {
      const src = vertical.matches ? video.dataset.srcV! : video.dataset.srcH!;
      if (video.getAttribute("src") === src) return;
      video.classList.remove("is-playing");
      video.src = src;
      video.play().catch(() => {});
    };
    video.muted = true;
    video.addEventListener("playing", () => video.classList.add("is-playing"));
    cargar();
    vertical.addEventListener("change", cargar);

    // la foto queda fija detrás de la hoja blanca: cuando ya la tapó por
    // completo se pausa el video para no gastar batería de balde
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const covered = window.scrollY > window.innerHeight * 1.05;
          if (covered && !video.paused) video.pause();
          else if (!covered && video.paused) video.play().catch(() => {});
        });
      },
      { passive: true },
    );
  }
</script>
